{
  "name": "devfest-frontend",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --port 4201 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "ng test --no-watch",
    "format": "prettier --plugin=prettier-plugin-java --write \"../backend/src/**/*.java\" \"src/**/*.{ts,html,css}\""
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.55.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "v86": "0.5.471"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@playwright/test": "1.64.1",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-java": "2.11.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
