# Copy to .env. Replace every placeholder. Do not use TeamQora DB settings.
DEVFEST_DB_URL=jdbc:postgresql://127.0.0.1:55432/devfest
DEVFEST_DB_USER=devfest
DEVFEST_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DEVFEST_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Orders each team's AI quiz questions, options and snippets. Required (32+ characters) unless DEVFEST_DEVELOPMENT=true.
DEVFEST_QUIZ_SHUFFLE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DEVFEST_ADMIN_EMAIL=admin@devfest.local
DEVFEST_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_12_PLUS_CHARACTER_PASSWORD
DEVFEST_SEED=true
# Public demo is suitable only for non-sensitive spike programs; event hosting must be vetted.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
DEVFEST_ORIGINS=http://localhost:4201
DEVFEST_WORKERS=4

DEVFEST_DEVELOPMENT=true
