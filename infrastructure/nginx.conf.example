# Example only. Configure TLS certificates and host names before event use.
# Serve frontend/dist/devfest/browser. Never serve the backend tree or .local directory.
limit_req_zone $binary_remote_addr zone=devfest:10m rate=200r/s;
server {
    listen 443 ssl;
    server_name REPLACE_EVENT_HOST;
    # ssl_certificate ...; ssl_certificate_key ...;
    root /srv/devfest/frontend/dist/devfest/browser;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    location /api/ {
        limit_req zone=devfest burst=400 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
