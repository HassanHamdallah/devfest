# Example only. Configure TLS certificates and host names before event use.
# Serve frontend/dist/devfest/browser. Never serve the backend tree or .local directory.
limit_req_zone $binary_remote_addr zone=devfest:10m rate=200r/s;
server {
    listen 443 ssl;
    server_name REPLACE_EVENT_HOST;
    # ssl_certificate ...; ssl_certificate_key ...;
    root /srv/devfest/frontend/dist/devfest/browser;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # 'wasm-unsafe-eval' lets the in-browser terminal (v86) compile its WebAssembly; it does not allow eval().
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    gzip on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
    # In-browser terminal: the emulator and Linux image never change under one ?v= version, so they are cached for a
    # year. The binaries are stored as .gz and inflated by the page; they must go out as they are (no gzip again,
    # no Content-Encoding), so only libv86.js is compressed here (gzip_types above).
    location /terminal/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    # Terminal files are up to 2 MB of text each; only this endpoint takes bodies above 1 MB.
    location ~ ^/api/v1/event/rooms/[0-9]+/terminal-files {
        client_max_body_size 5m;
        limit_req zone=devfest burst=400 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
    # Live revision push (Server-Sent Events): never buffer, keep the connection open up to the 30-minute stream.
    location = /api/v1/event/stream {
        limit_req zone=devfest burst=400 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 35m;
    }
    location /api/ {
        limit_req zone=devfest burst=400 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
