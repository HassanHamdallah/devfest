# DevFest production settings. Copy to /srv/devfest/backend/.env (owner devfest, chmod 600).
# setup-server.sh creates that file for you from this template and fills the secrets; edit it only to change something.
# Format: KEY=value, no quotes, no spaces around "=", no backslashes. Lines starting with # are comments.
# Everything the backend reads from the environment is listed here (checked against application.properties and the code).

# --- Database ---------------------------------------------------------------------------------------------------
# JDBC address of PostgreSQL on this same machine. The database MUST be named "devfest": the backend refuses any other name.
DEVFEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/devfest
# Database role the backend logs in as (created by setup-server.sh).
DEVFEST_DB_USER=devfest
# Password of that role. Generate:  openssl rand -base64 36 | tr -d '/+=\n'
DEVFEST_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# --- Security ---------------------------------------------------------------------------------------------------
# Secret that signs login tokens (at least 32 characters; a short or "REPLACE_" value stops the backend from starting).
# Changing it signs everybody out. Generate:  openssl rand -base64 48 | tr -d '/+=\n'
DEVFEST_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Browser origins allowed to call the API (CORS), comma separated, exactly as typed in the address bar:
# https, no trailing slash, no path. The site and the API share one origin behind nginx, so this is just your domain.
DEVFEST_ORIGINS=https://REPLACE_DOMAIN

# --- First administrator (created only while NO admin exists) ---------------------------------------------------
# Email of the first admin account. Used once; after the first sign-in change the password in the app and
# delete these two lines.
DEVFEST_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
# Its first password: 12 to 72 characters. Choose your own (no generation command; it is typed by a person).
DEVFEST_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_12_PLUS_CHARACTER_PASSWORD

# --- Switches that MUST stay off in production --------------------------------------------------------------------
# Loads sample programming problems into the old contest platform. Off.
DEVFEST_SEED=false
# Development mode (allows the public Judge0 demo and the practice-data seeder). Off.
DEVFEST_DEVELOPMENT=false
# Practice accounts/teams for rehearsals; only works in development mode. Leave empty (no seed password).
DEVFEST_EVENT_SEED_PASSWORD=
# How many practice teams that seeder would make; unused while the password above is empty.
DEVFEST_EVENT_SEED_TEAMS=16

# --- Code-execution service (Judge0): NOT needed for the event -----------------------------------------------------
# The event rooms (Crypto, Sentinel/AI, Linux terminal, Problem Solving via Codeforces links) never run participant
# code on the server; Judge0 only serves the older stand-alone contest platform (/api/v1/runs, /submissions).
# So leave every JUDGE0_* value empty and keep the background worker off. Do not point it at the public ce.judge0.com
# (the backend refuses that outside development mode anyway).
JUDGE0_URL=
JUDGE0_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=
# Only meaningful with a vetted Judge0 of your own; keep false.
JUDGE0_SECURITY_REVIEWED=false
# Background worker that sends contest submissions to Judge0: off, there is nothing to send.
DEVFEST_WORKER_ENABLED=false
# Worker threads (1 to 8); ignored while the worker is off.
DEVFEST_WORKERS=4

# Not settable here on purpose: PORT=8081 and SERVER_ADDRESS=127.0.0.1 come from devfest-backend.service.
